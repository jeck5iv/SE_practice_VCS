@startuml
title Диаграмма классов системы контроля версий

class Repository {
  +commit(message, author)
  +checkout(rev)
  +log()
  +merge(branch)
  +push()
  +pull()
  +clone(url)
}

class CommitManager {
  +create_commit(message, author)
  +get_commit(hash)
  +get_log(branch)
}

class MergeManager {
  +merge(branch)
  +resolve_conflicts()
}

class BranchManager {
  +create_branch(name)
  +delete_branch(name)
  +get_current()
}

class IndexManager {
  +stage_file(path)
  +unstage_file(path)
  +get_staged_files()
}

class RemoteClient {
  +clone(url)
  +fetch()
  +pull()
  +push()
}

class Branch {
  -name
  -head : Commit
}

class Commit {
  -hash
  -message
  -timestamp
  -author : User
  -parent : Commit
  -merged_parents : List<Commit>
  -files : Map<String, FileVersion>
}

class FileVersion {
  -path
  -delta
  -base : FileVersion
}

class Index {
  -staged_files : Map<String, String>
}

class User {
  -name
  -email
}

class WorkingDirectory {
  +read_file(path)
  +write_file(path, data)
}

class StorageManager {
  +store_commit(commit)
  +load_commit(hash)
  +store_blob(data)
  +load_blob(id)
}

class Hasher {
  +hash(data)
}

class Compressor {
  +compress(data)
  +decompress(data)
}

class ConflictResolver {
  +resolve(base, ours, theirs)
}

class Logger {
  +log(message)
}

' Связи
Repository --> CommitManager
Repository --> BranchManager
Repository --> MergeManager
Repository --> RemoteClient
Repository --> IndexManager

CommitManager --> Commit
Commit --> FileVersion
Commit --> User
Commit --> Commit : parent

BranchManager --> Branch
Branch --> Commit

MergeManager --> ConflictResolver
IndexManager --> Index
Index --> FileVersion
RemoteClient --> StorageManager
RemoteClient --> Hasher
RemoteClient --> Compressor
CommitManager --> Hasher
FileVersion --> Compressor
IndexManager --> WorkingDirectory

' Комментарии прямо на диаграмме
note right of FileVersion
  FileVersion использует дельта-компрессию.
  Хранит изменения относительно base.
  Позволяет быстро восстановить состояние.
end note

note right of Commit
  Commit: snapshot всех файлов, метаданные,
  ссылки на родителей (поддержка merge).
end note

note bottom of Repository
  Основной интерфейс библиотеки и CLI.
  Обрабатывает команды и взаимодействует
  со всеми подкомпонентами.
end note

note right of Branch
  Ветка хранит имя и указатель на коммит.
  При checkout — переключается HEAD.
end note

note left of RemoteClient
  Подключение к серверу по URL.
  Поддерживает clone, fetch, pull, push.
end note

note right of StorageManager
  Сохраняет и читает коммиты и blob'ы
  с использованием компрессии.
end note

@enduml
